<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[720px] px-5 py-8">

    <!-- ヘッダー -->
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-extrabold text-[#111827]">今日の5分行動</h1>
      <%= link_to wants_path,
            class: "text-sm font-bold text-[#6B7280] cursor-pointer
                    hover:text-[#111827] transition duration-150
                    focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1 rounded" do %>
        ← 戻る
      <% end %>
    </div>

    <!-- LINE通知導線 -->
    <% if current_user && !current_user.line_linked? %>
      <div class="mt-6 rounded-2xl border-2 border-[#111827] bg-white shadow-[4px_4px_0_#111827] px-5 pt-5 pb-6">

        <!-- アイコン + テキスト -->
        <div class="flex items-start gap-3">
          <div class="shrink-0 flex h-10 w-10 items-center justify-center rounded-xl border-2 border-[#111827] bg-[#06C755] shadow-[2px_2px_0_#111827]">
            <svg class="h-5 w-5 fill-white" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-extrabold text-[#111827]">毎日LINEで5分行動を受け取る</p>
            <p class="mt-0.5 text-xs leading-5 text-[#6B7280]">LINEと連携すると、今日の5分行動が毎朝あなたのLINEに届きます。</p>
          </div>
        </div>

        <!-- CTAボタン -->
        <div class="mt-4 flex justify-center">
          <%= link_to edit_notification_setting_path, class: "inline-flex items-center justify-center rounded-full border-2 border-[#111827] bg-[#06C755] px-8 py-3 text-sm font-extrabold text-white shadow-[4px_4px_0_#111827] transition-all duration-150 hover:-translate-y-[1px] hover:shadow-[4px_6px_0_#111827] active:translate-y-[1px] active:shadow-[4px_2px_0_#111827]" do %>
            LINEの設定をする
          <% end %>
        </div>

      </div>
    <% end %>

    <!-- AI Action カード -->
    <section class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-5">
      <p class="text-base font-extrabold text-[#6B7280]">AI Action</p>
      <p class="mt-1 text-sm font-extrabold text-[#111827]">⚡ 今日の5分行動</p>

      <turbo-frame id="ai-suggestion" class="block mt-4">
        <% if @daily %>
          <%= render "ai_suggestions/card", daily: @daily %>
        <% else %>
          <%= render "ai_suggestions/card", daily: nil, no_wants: true %>
        <% end %>
      </turbo-frame>
    </section>

  </div>
</div>
