<% if daily %>
  <%# 提案済み表示 %>

  <%# 対象のやりたいこと %>
  <div class="pt-4 border-t border-[#111827]/10">
    <p class="text-xs font-bold text-[#6B7280]">対象のやりたいこと</p>
    <p class="mt-1 text-base font-extrabold text-[#111827]"><%= daily.want.title %></p>
  </div>

  <%# 5分行動提案 %>
  <div class="mt-4 pt-4 border-t border-[#111827]/10">
    <div class="flex items-center gap-2 mb-3">
      <span>💡</span>
      <span class="bg-[#ECFDF5] text-[#065F46] rounded-full px-3 py-1 text-xs font-bold">5分行動</span>
    </div>
    <p class="whitespace-pre-wrap text-sm font-bold text-[#111827] leading-relaxed"><%= daily.suggested_action %></p>
  </div>

  <%# 別の提案を聞くボタン %>
  <div class="mt-4 pt-4 border-t border-[#111827]/10">
    <%= form_with url: ai_suggestion_path, method: :post, data: { turbo_frame: "ai-suggestion" } do |f| %>
      <%= f.submit "🔄 別の提案を聞く",
            data: { turbo_submits_with: "⏳ AIが考えています..." },
            class: "w-full cursor-pointer rounded-full border border-[#111827]/25 bg-white
                    px-5 py-3 text-sm font-extrabold text-[#111827]
                    hover:bg-[#F3F4F6] hover:shadow-sm hover:-translate-y-0.5 transition duration-150 disabled:opacity-60" %>
    <% end %>
  </div>

<% else %>
  <%# 未提案 %>
  <% if defined?(no_wants) && no_wants %>
    <%# やりたいことが1件もない %>
    <div class="pt-4 border-t border-[#111827]/10 py-4 text-center">
      <p class="text-2xl mb-3">🌱</p>
      <p class="text-sm font-extrabold text-[#111827]">まずはやりたいことを登録しよう！</p>
      <p class="mt-1 text-xs text-[#6B7280]">やりたいことを追加すると、AIが毎日5分でできる行動を提案します。</p>
      <%= link_to "やりたいことを追加する", new_want_path,
            class: "mt-4 inline-flex items-center justify-center rounded-full border-2 border-[#111827] bg-[#111827] px-6 py-3 text-sm font-extrabold text-white shadow-[4px_4px_0_#6B7280] transition-all duration-150 hover:opacity-90 hover:-translate-y-0.5" %>
    </div>
  <% else %>
    <%= form_with url: ai_suggestion_path, method: :post, data: { turbo_frame: "ai-suggestion" } do |f| %>
      <%= f.submit "⚡ 今日の5分行動を提案してもらう",
            class: "w-full cursor-pointer rounded-full bg-[#111827] px-5 py-3 text-base font-extrabold text-white hover:opacity-90" %>
    <% end %>
    <p class="mt-3 text-center text-xs font-bold text-[#6B7280]">明日も小さな一歩を。</p>
  <% end %>
<% end %>
