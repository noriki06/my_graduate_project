<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[720px] px-5 py-8">

    <%# ===== 数値定義 ===== %>
    <% progress = (current_user&.life_progress_rate || 0).to_f.clamp(0, 100) %>
    <% remaining_days = (current_user&.remaining_life_days || 0).to_i %>

    <% achieve_rate = (@achieve_rate || 0).to_f.clamp(0, 100) %>
    <% achieved_count = (@achieved_wants_count || 0).to_i %>
    <% total_count = (@total_wants_count || 0).to_i %>

    <!-- ===== ヘッダー ===== -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-3xl font-extrabold text-[#111827]">ライフゲージ</h1>

      <div class="flex flex-wrap items-center gap-2">
        <%= link_to public_wants_path,
              class: "inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-[#111827]/25 bg-white px-3 py-1.5 text-sm font-bold sm:px-5 sm:py-2 sm:text-base" do %>
          🏆 みんなの達成
        <% end %>

        <%= link_to public_wishlist_path,
              class: "inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-[#111827]/25 bg-white px-3 py-1.5 text-sm font-bold sm:px-5 sm:py-2 sm:text-base" do %>
          🌍 みんなのやりたいこと
        <% end %>

        <%= link_to edit_user_registration_path,
              class: "inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-[#111827]/25 bg-white px-3 py-1.5 text-sm font-bold sm:px-5 sm:py-2 sm:text-base" do %>
          👤 プロフィール
        <% end %>

        <%= link_to root_path,
              class: "inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-[#111827]/25 bg-white px-3 py-1.5 text-sm font-bold sm:px-5 sm:py-2 sm:text-base" do %>
          🏠 トップ
        <% end %>

        <%= link_to new_want_path,
          class: "inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-[#111827]/25 bg-white px-3 py-1.5 text-sm font-bold sm:px-5 sm:py-2 sm:text-base" do %>
          ＋ やりたいことを追加
        <% end %>
      </div>
    </div>

    <!-- ===== ライフゲージカード ===== -->
    <section class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-5">

      <div class="flex items-center justify-between">
        <p class="text-base font-extrabold text-[#6B7280]">ライフゲージ</p>
      </div>

      <!-- ===== 人生進捗率 ===== -->
      <div class="mt-4">
        <div class="flex items-end justify-between">
          <p class="text-sm font-extrabold text-[#111827]">人生進捗率</p>
          <p class="text-2xl font-extrabold text-[#111827]">
            <%= number_with_precision(progress, precision: 1) %><span class="text-sm">%</span>
          </p>
        </div>

        <p class="mt-1 text-xs font-bold text-[#6B7280]">
          残り <%= remaining_ymd_text(remaining_days) %>
        </p>

        <!-- 修正版バー -->
        <div class="mt-3 h-3 w-full rounded-full overflow-hidden" style="background:#E9EEF5;">
          <div style="width: <%= progress %>%; height: 100%; background:#FF5C5C;"></div>
        </div>
      </div>

      <!-- ===== 思い出の達成率 ===== -->
      <div class="mt-6">
        <div class="flex items-end justify-between">
          <p class="text-sm font-extrabold text-[#111827]">思い出の達成率</p>
          <p class="text-2xl font-extrabold text-[#111827]">
            <%= number_with_precision(achieve_rate, precision: 1) %><span class="text-sm">%</span>
          </p>
        </div>

        <p class="mt-1 text-xs font-bold text-[#6B7280]">
          <%= total_count.positive? ? "#{achieved_count} / #{total_count} 達成" : "まずは「やりたいこと」を登録してみましょう" %>
        </p>

        <!-- 修正版バー -->
        <div class="mt-3 h-3 w-full rounded-full bg-[#E9EEF5] overflow-hidden">
          <div class="h-full bg-[#1FA971]" style="width: <%= achieve_rate %>%;"></div>
        </div>
      </div>

    </section>

    <!-- ===== DIE WITH ZERO ===== -->
    <section class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-5">
      <div class="border-l-4 border-[#FFE57A] pl-4">
        <p class="text-sm font-extrabold leading-7 text-[#111827]">
          「人生の最後に残るのは、<br>
          集めたお金ではなく、積み上げた思い出だ」
        </p>
        <p class="mt-2 text-xs font-bold text-[#6B7280]">
          書籍『DIE WITH ZERO』より
        </p>
      </div>
    </section>

    <!-- ===== やりたいこと ===== -->
    <section class="mt-6 rounded-2xl border border-[#111827]/20 bg-white">
      <div class="flex items-center justify-between px-5 py-4">
        <h2 class="text-2xl font-extrabold text-[#111827]">やりたいこと</h2>
      </div>

      <div class="border-t border-[#111827]/10"></div>

      <div class="px-5 py-4 space-y-2">
        <% if @wants_by_bucket.present? %>
          <% @wants_by_bucket.each_with_index do |(bucket, wants), idx| %>

            <div class="py-3">
              <div class="flex items-center justify-between">
                <h3 class="text-base font-extrabold text-[#111827]">
                  <%= "#{bucket}歳（#{bucket_subname(bucket)}）" %>
                </h3>

                <div class="flex items-center gap-3">
                  <%= link_to new_want_path(time_bucket: bucket),
                        class: "text-xs font-extrabold text-[#1FA971] hover:opacity-80" do %>
                    ＋追加
                  <% end %>

                  <% if wants.size.positive? %>
                    <span class="text-xs font-bold text-[#6B7280]"><%= wants.size %>件</span>
                  <% end %>
                </div>
              </div>

              <% if wants.empty? %>
                <p class="mt-1 text-xs font-bold text-[#6B7280]">未登録</p>
              <% else %>
                <div class="mt-2 space-y-3">
                  <% wants.each do |want| %>
                    <%= render "wants/want_row", want: want %>
                  <% end %>
                </div>
              <% end %>
            </div>

            <% unless idx == @wants_by_bucket.size - 1 %>
              <div class="border-t border-[#111827]/10"></div>
            <% end %>

          <% end %>
        <% end %>

        <!-- 下部追加ボタン -->
        <div class="pt-2">
          <%= link_to new_want_path,
                class: "w-full inline-flex items-center justify-center rounded-full bg-[#111827] px-5 py-3 text-base font-extrabold text-white hover:opacity-90" do %>
            ＋ やりたいことを追加
          <% end %>
        </div>
      </div>
    </section>

  </div>
</div>
