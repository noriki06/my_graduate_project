<div style="margin-bottom: 18px; padding: 14px; background-color: #f3f4f6; border-radius: 8px;">
  <p style="margin: 0 0 8px; font-weight: bold;">ライフゲージ（人生進捗率）</p>

  <% if @life_progress_rate %>
    <p style="margin: 0 0 8px;">
      進捗：<strong><%= @life_progress_rate %>%</strong>
    </p>

    <progress value="<%= @life_progress_rate %>" max="100" style="width: 100%; height: 16px;"></progress>
  <% else %>
    <p style="margin: 0;">生年月日が未登録です。</p>
  <% end %>
</div>

<h1>やりたいこと一覧</h1>

<% if @wants.any? %>
  <ul>
    <% @wants.each do |want| %>
      <li>
        <%= link_to want.title, want_path(want) %>

        <% if want.achieved? %>
          <span style="margin-left: 8px; padding: 2px 8px; background-color: #e5e7eb; border-radius: 9999px; font-size: 12px;">
            ✅ 達成（<%= want.achieved_at.strftime("%Y/%m/%d") %>）
          </span>
        <% else %>
          <span style="margin-left: 8px; padding: 2px 8px; background-color: #fef3c7; border-radius: 9999px; font-size: 12px;">
            ⏳ 未達成
          </span>
        <% end %>

        <%= link_to "編集", edit_want_path(want), style: "margin-left: 10px;" %>
        <%= link_to "削除", want_path(want),
              data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
              style: "margin-left: 6px;" %>
      </li>
    <% end %>
  </ul>

<% else %>
  <div style="text-align:center; margin-top:30px; padding:30px; background-color:#f3f4f6; border-radius:8px;">
    <p style="font-size:18px; margin-bottom:8px;">まだ登録がありません。</p>
    <p style="color:#6b7280; margin-bottom:16px;">今思い浮かぶ小さなことから書いてみましょう。</p>
    <p style="color:#6b7280; font-size:14px; margin-bottom:20px;">例：温泉旅行に行く / 映画を10本見る</p>

    <%= link_to "＋ やりたいことを追加する",
          new_want_path,
          style: "padding:12px 24px; background-color:#3b82f6; color:white;
                  border-radius:4px; text-decoration:none; display:inline-block;" %>
  </div>
<% end %>
