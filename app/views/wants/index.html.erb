<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[720px] px-5 py-8">

    <%# 進捗値（リザルトページの式を流用） %>
    <% progress = (current_user&.life_progress_rate || 0).to_f.clamp(0, 100) %>
    <% remaining_days = (current_user&.remaining_life_days || 0).to_i %>

    <!-- ヘッダー -->
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-extrabold text-[#111827]">ライフゲージ</h1>

      <div class="flex items-center gap-3">
        <%= link_to edit_user_registration_path,
              class: "inline-flex items-center gap-2 rounded-full border border-[#111827]/25 bg-white px-5 py-2 text-base font-bold" do %>
          👤 プロフィール
        <% end %>
        <%= link_to root_path,
              class: "inline-flex items-center gap-2 rounded-full border border-[#111827]/25 bg-white px-5 py-2 text-base font-bold" do %>
          🏠 トップ
        <% end %>

        <%= link_to new_want_path,
          class: "inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-[#111827]/25 bg-white px-5 py-2 text-base font-bold" do %>
          ＋ やりたいことを追加
        <% end %>
      </div>
    </div>

    <!-- 人生進捗率カード（棒グラフあり） -->
    <section class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-5">
      <p class="text-base font-extrabold text-[#6B7280]">人生進捗率</p>

      <div class="mt-3 flex items-end justify-between gap-4">
        <div>
          <div class="flex items-baseline gap-2">
            <p class="text-6xl font-extrabold text-[#111827]"><%= number_with_precision(progress, precision: 1) %></p>
            <span class="text-2xl font-extrabold text-[#111827]">%</span>
          </div>

          <p class="mt-1 text-2xl font-bold text-[#6B7280]">
            残り <%= remaining_ymd_text(remaining_days) %>
          </p>
        </div>
      </div>


      <!-- 棒グラフ -->
      <div class="mt-4 h-3 w-full rounded-full bg-[#E9EEF5]">
        <div class="h-3 rounded-full bg-[#1FA971]" style="width:<%= progress %>%"></div>
      </div>
    </section>

    <!-- DIE WITH ZERO 引用 -->
    <section class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-5">
      <div class="border-l-4 border-[#FFE57A] pl-4">
        <p class="text-sm font-extrabold leading-7 text-[#111827]">
          「人生の最後に残るのは、<br>
          集めたお金ではなく、積み上げた思い出だ」
        </p>
        <p class="mt-2 text-xs font-bold text-[#6B7280]">
          書籍『DIE WITH ZERO』より
        </p>
      </div>
    </section>

    <!-- やりたいこと -->
    <section class="mt-6 rounded-2xl border border-[#111827]/20 bg-white">
      <div class="flex items-center justify-between px-5 py-4">
        <h2 class="text-2xl font-extrabold text-[#111827]">やりたいこと</h2>
      </div>

      <div class="border-t border-[#111827]/10"></div>

      <div class="px-5 py-4 space-y-3">
        <% if @wants.any? %>
          <% @wants.each do |want| %>
            <%= render "wants/want_row", want: want %>
          <% end %>

          <div class="mt-4 flex justify-center">
            <%= paginate @wants %>
          </div>
        <% else %>
          <div class="space-y-3">
            <p class="text-sm font-bold text-[#6B7280]">
              まずは例を参考に、1つ登録してみましょう
            </p>

            <% sample_wants = [
              { title: "海外旅行に行く", target: "2026/06/01" },
              { title: "フルマラソン完走", target: "未定" },
              { title: "両親と旅行する", target: "未定" }
            ] %>

            <% sample_wants.each do |sample| %>
              <div class="rounded-2xl border border-dashed border-[#111827]/25 bg-[#FBF6E9] px-5 py-4">
                <p class="text-lg font-extrabold text-[#111827]">
                  <%= sample[:title] %>
                </p>

                <p class="mt-2 text-sm font-bold text-[#6B7280]">
                  達成目標日：<%= sample[:target] %>
                </p>

                <p class="mt-3 text-xs font-bold text-[#6B7280]">
                  ※ これは例です（保存されません）
                </p>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- ★常に表示する：下部追加ボタン -->
        <div class="pt-2">
          <%= link_to new_want_path,
                class: "w-full inline-flex items-center justify-center gap-2 rounded-full bg-[#111827] px-5 py-3 text-base font-extrabold text-white hover:opacity-90" do %>
            ＋ やりたいことを追加
          <% end %>
        </div>
      </div>
    </section>

  </div>
</div>
