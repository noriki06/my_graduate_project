<% achieved = want.achieved? %>

<div class="<%= achieved ? "opacity-40" : "" %> rounded-3xl border-2 border-[#111827] bg-white p-5 shadow-[6px_6px_0_#111827]">
  <p class="text-xl font-extrabold text-[#111827]"><%= want.title %></p>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <% if achieved %>
      <span class="inline-flex items-center gap-2 rounded-full border-2 border-[#111827] bg-[#E5E7EB] px-3 py-1 text-xs font-extrabold">
        ✓ 達成済み
      </span>
    <% else %>
      <span class="inline-flex items-center gap-2 rounded-full border-2 border-[#111827] bg-[#F7D95B] px-3 py-1 text-xs font-extrabold">
        ⏳ 未達成
      </span>
    <% end %>

    <% if want.target_date.present? %>
      <span class="inline-flex items-center gap-2 rounded-full border-2 border-[#111827] bg-[#CFF3F6] px-3 py-1 text-xs font-extrabold">
        📅 <%= l(want.target_date) %>
      </span>
    <% else %>
      <span class="inline-flex items-center gap-2 rounded-full border-2 border-[#111827] bg-[#E5E7EB] px-3 py-1 text-xs font-extrabold">
        📅 期限なし
      </span>
    <% end %>
  </div>

  <div class="mt-4 border-t-2 border-[#111827]/10 pt-4 flex items-center justify-end gap-3">
    <%= link_to edit_want_path(want),
          class: "inline-flex items-center justify-center gap-2 rounded-full border-2 border-[#111827] bg-white px-6 py-2 text-sm font-extrabold shadow-[3px_3px_0_#111827] active:translate-x-[1px] active:translate-y-[1px]" do %>
      ✏️ 編集
    <% end %>

    <%= button_to want_path(want),
          method: :delete,
          data: { turbo_confirm: "削除しますか？" },
          class: "inline-flex items-center justify-center gap-2 rounded-full border-2 border-[#111827] bg-white px-6 py-2 text-sm font-extrabold shadow-[3px_3px_0_#111827] active:translate-x-[1px] active:translate-y-[1px]" do %>
      🗑 削除
    <% end %>
  </div>
</div>
