<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[520px] px-5 py-10">

    <!-- ヘッダー -->
    <div class="flex items-start justify-between gap-4">
      <h1 class="min-w-0 flex-1 text-2xl sm:text-3xl font-extrabold text-[#111827] break-words">
        <%= @want.title %>
      </h1>

      <%= link_to wants_path,
            class: "shrink-0 text-sm font-bold text-[#6B7280] hover:underline" do %>
        戻る
      <% end %>
    </div>

    <!-- メインカード -->
    <div class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-6">

      <!-- 写真 -->
      <% if @want.picture.attached? %>
        <div class="mb-5">
          <%= image_tag @want.picture.variant(resize_to_limit: [520, 520]),
                alt: @want.title,
                class: "w-full rounded-xl object-cover" %>
        </div>
      <% end %>

      <!-- メモ -->
      <% if @want.memo.present? %>
        <div>
          <p class="text-sm font-extrabold text-[#6B7280]">メモ</p>
          <p class="mt-1 text-base text-[#111827]">
            <%= simple_format(@want.memo) %>
          </p>
        </div>
      <% end %>

      <!-- 目標日 -->
      <div class="mt-4">
        <p class="text-sm font-extrabold text-[#6B7280]">目標日</p>
        <p class="mt-1 text-base font-bold text-[#111827]">
          <%= @want.target_date.present? ? l(@want.target_date) : "未設定" %>
        </p>
      </div>

      <hr class="my-5 border-[#111827]/10">

      <% if @want.achieved? %>
        <div>
          <p class="text-sm font-extrabold text-[#6B7280]">達成日</p>
          <p class="mt-1 text-base font-bold text-[#111827]">
            <%= @want.achieved_at.strftime("%Y/%m/%d") %>
          </p>
        </div>

        <% if @want.achieved_image.attached? %>
          <div class="mt-4">
            <p class="text-sm font-extrabold text-[#6B7280]">達成の写真</p>
            <div class="mt-2">
              <%= image_tag @want.achieved_image.variant(resize_to_limit: [520, 520]),
                    alt: "達成写真",
                    class: "w-full rounded-xl object-cover" %>
            </div>
          </div>
        <% end %>

        <% if @want.achievement_note.present? %>
          <div class="mt-4">
            <p class="text-sm font-extrabold text-[#6B7280]">達成メモ</p>
            <p class="mt-1 text-base text-[#111827]">
              <%= simple_format(@want.achievement_note) %>
            </p>
          </div>
        <% end %>
      <% else %>
        <%= link_to "達成した（記録を書く）",
              achieve_form_want_path(@want),
              class: "inline-block rounded-full bg-[#1FA971] px-6 py-3 text-sm font-extrabold text-white hover:opacity-90" %>
      <% end %>
    </div>

    <!-- アクションボタン -->
    <div class="mt-6 flex gap-3">
      <%= link_to "編集",
            edit_want_path(@want),
            class: "flex-1 rounded-full border border-[#111827]/30 py-3 text-center text-base font-extrabold text-[#111827] hover:bg-white" %>

      <%= link_to "削除",
            want_path(@want),
            data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
            class: "flex-1 rounded-full border border-[#EF4444]/30 py-3 text-center text-base font-extrabold text-[#EF4444] hover:bg-red-50" %>
    </div>

  </div>
</div>
