<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[520px] px-5 py-10">

    <!-- ヘッダー -->
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-extrabold text-[#111827]">
        やりたいこと登録
      </h1>

      <%= link_to wants_path,
            class: "text-sm font-bold text-[#6B7280] hover:underline" do %>
        戻る
      <% end %>
    </div>

    <!-- フォームカード -->
    <div class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-6">
      <%= form_with model: @want, local: true do |f| %>
        <% if @prefill_time_bucket.present? %>
          <div class="mb-5 rounded-2xl border border-[#111827]/20 bg-[#FBF6E9] px-5 py-4">
            <p class="text-sm font-extrabold text-[#111827]">
              選択中の年代：<%= @prefill_time_bucket %>歳
            </p>
            <p class="mt-1 text-xs font-bold text-[#6B7280]">
              年齢（◯歳までに）または目標日を入力すると、自動でこの年代に振り分けられます
            </p>
          </div>
        <% end %>

        <% if @want.errors.any? %>
          <div class="mb-5 rounded-2xl border border-red-200 bg-red-50 px-5 py-4">
            <p class="text-sm font-extrabold text-red-700">
              入力内容を確認してください
            </p>
            <ul class="mt-2 list-disc pl-5 text-sm font-bold text-red-700">
              <% @want.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- やりたいこと -->
        <div>
          <%= f.label :title,
                "やりたいこと",
                class: "text-sm font-extrabold text-[#6B7280]" %>

          <%= f.text_field :title,
                placeholder: "例：海外旅行に行く",
                class: "mt-2 w-full rounded-xl border border-[#111827]/20 px-4 py-3 text-base font-bold text-[#111827] focus:border-[#1FA971] focus:outline-none" %>
        </div>

        <!-- メモ -->
        <div class="mt-5">
          <%= f.label :memo,
                "メモ",
                class: "text-sm font-extrabold text-[#6B7280]" %>

          <%= f.text_area :memo,
                rows: 5,
                placeholder: "なぜやりたいか、きっかけなど",
                class: "mt-2 w-full rounded-xl border border-[#111827]/20 px-4 py-3 text-base text-[#111827] focus:border-[#1FA971] focus:outline-none" %>
        </div>

        <!-- 目標：年齢 or 日付 -->
        <div class="mt-5">
          <p class="text-sm font-extrabold text-[#6B7280]">目標</p>

          <!-- 年齢入力 -->
          <div class="mt-2">
            <%= label_tag :target_age,
                  "◯歳までに",
                  class: "text-sm font-extrabold text-[#6B7280]" %>

            <%= number_field_tag :target_age,
                  params[:target_age],
                  min: 0,
                  max: 120,
                  placeholder: "例：60",
                  class: "mt-2 w-full rounded-xl border border-[#111827]/20 px-4 py-3 text-base font-bold text-[#111827] focus:border-[#1FA971] focus:outline-none" %>

            <p class="mt-1 text-xs font-bold text-[#6B7280]">
              入力すると「あなたの誕生日 + 年齢」で目標日を自動計算します
            </p>
          </div>

          <!-- 区切り -->
          <div class="my-4 flex items-center gap-3">
            <div class="h-px flex-1 bg-[#111827]/10"></div>
            <span class="text-xs font-bold text-[#6B7280]">または</span>
            <div class="h-px flex-1 bg-[#111827]/10"></div>
          </div>

          <!-- 日付入力 -->
          <div>
            <%= f.label :target_date,
                  "目標日",
                  class: "text-sm font-extrabold text-[#6B7280]" %>

            <%= f.date_field :target_date,
                  class: "mt-2 w-full rounded-xl border border-[#111827]/20 px-4 py-3 text-base font-bold text-[#111827] focus:border-[#1FA971] focus:outline-none" %>

            <p class="mt-1 text-xs font-bold text-[#6B7280]">
              <% if @prefill_time_bucket.present? %>
                ※この年代に入れたい場合は「◯歳までに」か「目標日」を入力してください
              <% else %>
                未設定でもOK
              <% end %>
            </p>
          </div>
        </div>

        <!-- ボタン -->
        <div class="mt-8 flex gap-3">
          <%= f.submit "登録する",
                class: "flex-1 rounded-full bg-[#111827] py-3 text-base font-extrabold text-white hover:opacity-90" %>

          <%= link_to "キャンセル",
                wants_path,
                class: "flex-1 rounded-full border border-[#111827]/30 py-3 text-center text-base font-extrabold text-[#111827] hover:bg-[#FBF6E9]" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
