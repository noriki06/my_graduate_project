<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[520px] px-5 py-10">

    <!-- ヘッダー -->
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-extrabold text-[#111827]">
        やりたいこと登録
      </h1>

      <%= link_to wants_path,
            class: "text-sm font-bold text-[#6B7280] hover:underline" do %>
        戻る
      <% end %>
    </div>

    <!-- フォームカード -->
    <div class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-6">
      <%= form_with model: @want, local: true do |f| %>

        <!-- やりたいこと -->
        <div>
          <%= f.label :title,
                "やりたいこと",
                class: "text-sm font-extrabold text-[#6B7280]" %>

          <%= f.text_field :title,
                placeholder: "例：海外旅行に行く",
                class: "mt-2 w-full rounded-xl border border-[#111827]/20 px-4 py-3 text-base font-bold text-[#111827] focus:border-[#1FA971] focus:outline-none" %>
        </div>

        <!-- メモ -->
        <div class="mt-5">
          <%= f.label :memo,
                "メモ",
                class: "text-sm font-extrabold text-[#6B7280]" %>

          <%= f.text_area :memo,
                rows: 5,
                placeholder: "なぜやりたいか、きっかけなど",
                class: "mt-2 w-full rounded-xl border border-[#111827]/20 px-4 py-3 text-base text-[#111827] focus:border-[#1FA971] focus:outline-none" %>
        </div>

        <!-- 目標日 -->
        <div class="mt-5">
          <%= f.label :target_date,
                "目標日",
                class: "text-sm font-extrabold text-[#6B7280]" %>

          <%= f.date_field :target_date,
                class: "mt-2 w-full rounded-xl border border-[#111827]/20 px-4 py-3 text-base font-bold text-[#111827] focus:border-[#1FA971] focus:outline-none" %>

          <p class="mt-1 text-xs font-bold text-[#6B7280]">
            未設定でもOK
          </p>
        </div>

        <!-- ボタン -->
        <div class="mt-8 flex gap-3">
          <%= f.submit "登録する",
                class: "flex-1 rounded-full bg-[#111827] py-3 text-base font-extrabold text-white hover:opacity-90" %>

          <%= link_to "キャンセル",
                wants_path,
                class: "flex-1 rounded-full border border-[#111827]/30 py-3 text-center text-base font-extrabold text-[#111827] hover:bg-[#FBF6E9]" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
