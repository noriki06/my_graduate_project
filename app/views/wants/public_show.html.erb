<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[520px] px-5 py-10">

    <!-- ヘッダー -->
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-extrabold text-[#111827]">
        <%= @want.title %>
      </h1>

      <%= link_to public_wants_path,
            class: "text-sm font-bold text-[#6B7280] hover:underline" do %>
        戻る
      <% end %>
    </div>

    <!-- 投稿者 -->
    <p class="mt-2 text-sm font-bold text-[#6B7280]">
      👤 <%= @want.user.name.presence || @want.user.email %>
    </p>

    <!-- いいねボタン -->
    <div class="mt-4 flex items-center gap-3">
      <% liked = @want.likes.any? { |l| l.user_id == current_user.id } %>
      <% if liked %>
        <%= button_to unlike_want_path(@want), method: :delete,
              class: "rounded-full border border-[#1FA971] bg-[#ECFDF5] px-5 py-2 text-sm font-bold text-[#065F46]" do %>
          👍 いいね済み <%= @want.likes.size %>
        <% end %>
      <% else %>
        <%= button_to like_want_path(@want), method: :post,
              class: "rounded-full border border-[#111827]/20 bg-white px-5 py-2 text-sm font-bold text-[#111827]" do %>
          👍 いいね <%= @want.likes.size %>
        <% end %>
      <% end %>
      <span class="text-sm text-[#6B7280] font-bold">💬 <%= @want.comments.size %>件</span>
    </div>

    <!-- メインカード -->
    <div class="mt-4 rounded-2xl border border-[#111827]/20 bg-white p-6">

      <!-- 写真 -->
      <% if @want.picture.attached? %>
        <div class="mb-5">
          <%= image_tag @want.picture.variant(resize_to_limit: [520, 520]),
                alt: @want.title,
                class: "w-full rounded-xl object-cover" %>
        </div>
      <% end %>

      <!-- メモ -->
      <% if @want.memo.present? %>
        <div>
          <p class="text-sm font-extrabold text-[#6B7280]">メモ</p>
          <p class="mt-1 text-base text-[#111827]">
            <%= simple_format(h(@want.memo)) %>
          </p>
        </div>
      <% end %>

      <hr class="my-5 border-[#111827]/10">

      <% if @want.achieved? %>
        <!-- 達成情報 -->
        <div>
          <p class="text-sm font-extrabold text-[#6B7280]">達成日</p>
          <p class="mt-1 text-base font-bold text-[#111827]">
            <%= @want.achieved_at.strftime("%Y/%m/%d") %>
          </p>
        </div>

        <% if @want.achieved_image.attached? %>
          <div class="mt-4">
            <p class="text-sm font-extrabold text-[#6B7280]">達成の写真</p>
            <div class="mt-2">
              <%= image_tag @want.achieved_image.variant(resize_to_limit: [520, 520]),
                    alt: "達成写真",
                    class: "w-full rounded-xl object-cover" %>
            </div>
          </div>
        <% end %>

        <% if @want.achievement_note.present? %>
          <div class="mt-4">
            <p class="text-sm font-extrabold text-[#6B7280]">達成メモ</p>
            <div class="mt-1 text-base text-[#111827]">
              <%= simple_format(h(@want.achievement_note)) %>
            </div>
          </div>
        <% end %>
      <% else %>
        <!-- 未達成：目標日 -->
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#111827]/20 bg-[#F3F4F6] px-3 py-1 text-sm font-bold text-[#111827]">
            ⏳ 未達成
          </span>
          <% if @want.target_date.present? %>
            <p class="mt-2 text-sm font-bold text-[#6B7280]">
              達成目標日：<%= @want.target_date.strftime("%Y/%m/%d") %>
            </p>
          <% end %>
        </div>
      <% end %>

    </div>

    <!-- コメントセクション -->
    <div class="mt-6">
      <h2 class="text-lg font-extrabold text-[#111827]">💬 コメント</h2>

      <!-- コメント一覧 -->
      <% if @want.comments.any? %>
        <div class="mt-3 space-y-3">
          <% @want.comments.order(created_at: :asc).each do |comment| %>
            <div class="rounded-xl border border-[#111827]/10 bg-white p-4">
              <div class="flex items-start justify-between gap-2">
                <div class="flex-1">
                  <p class="text-xs font-bold text-[#6B7280]">
                    👤 <%= comment.user.name.presence || comment.user.email %>
                    <span class="ml-2 font-normal">
                      <%= comment.created_at.strftime("%Y/%m/%d %H:%M") %>
                    </span>
                  </p>
                  <div class="mt-1 text-sm text-[#111827]">
                    <%= simple_format(h(comment.content)) %>
                  </div>
                </div>
                <% if comment.user_id == current_user.id %>
                  <%= button_to comment_path(comment), method: :delete,
                        class: "shrink-0 text-xs font-bold text-[#6B7280] hover:text-red-500",
                        data: { turbo_confirm: "削除しますか？" } do %>
                    削除
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="mt-3 text-sm font-bold text-[#6B7280]">まだコメントはありません。</p>
      <% end %>

      <!-- コメント投稿フォーム -->
      <div class="mt-4 rounded-xl border border-[#111827]/10 bg-white p-4">
        <%= form_with url: want_comments_path(@want), model: @comment do |f| %>
          <%= f.text_area :content,
                placeholder: "コメントを入力...",
                rows: 3,
                class: "w-full resize-none rounded-lg border border-[#111827]/20 p-3 text-sm text-[#111827] focus:outline-none focus:ring-2 focus:ring-[#1FA971]/50" %>
          <%= f.submit "投稿する",
                class: "mt-2 rounded-full bg-[#111827] px-5 py-2 text-sm font-bold text-white cursor-pointer" %>
        <% end %>
      </div>
    </div>

  </div>
</div>
