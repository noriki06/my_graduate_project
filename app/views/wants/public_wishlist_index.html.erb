<%# ── みんな サブナビ ── %>
<% content_for :subnav do %>
  <div class="flex items-center gap-2">
    <%= link_to public_wants_path,
          class: "inline-flex items-center whitespace-nowrap rounded-full border border-[#111827]/25 bg-white
                  px-4 py-1.5 text-sm font-bold text-[#111827] cursor-pointer
                  hover:bg-[#F9FAFB] hover:shadow-sm hover:-translate-y-0.5 transition duration-150
                  focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" do %>
      みんなの達成
    <% end %>
    <span class="inline-flex items-center whitespace-nowrap rounded-full border border-transparent
                 bg-[#111827] text-white px-4 py-1.5 text-sm font-bold">
      みんなのやりたいこと
    </span>
  </div>
<% end %>

<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[720px] px-5 py-8">
    <h1 class="mb-6 text-3xl font-extrabold text-[#111827]">みんなのやりたいこと</h1>

    <section class="rounded-2xl border border-[#111827]/20 bg-white p-5">
      <p class="text-base font-extrabold text-[#6B7280]">みんなのやりたいこと（未達成）</p>

      <div class="mt-4">
        <% if @wants.any? %>
          <% @wants.each do |want| %>
            <!-- 投稿者名 -->
            <p class="mb-1 text-xs font-bold text-[#6B7280]">
              👤 <%= want.user.name.presence || want.user.email %>
            </p>

            <%= render "wants/want_row", want: want, public_view: true %>

            <!-- アクション帯 -->
            <div class="mb-3 mt-2 flex items-center gap-3 px-2">
              <%# いいね判定: 投稿者かどうかに関係なく「current_userがいいねしているか」のみで判定 %>
              <% liked = want.likes.any? { |l| l.user_id == current_user.id } %>
              <% if liked %>
                <%= button_to unlike_want_path(want), method: :delete,
                      class: "rounded-full border border-[#1FA971] bg-[#E6F7EF] px-4 py-2 text-sm font-bold text-[#065F46] cursor-pointer
                              hover:opacity-80 transition duration-150
                              focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1FA971] focus-visible:ring-offset-1" do %>
                  👍 <%= want.likes.size %>
                <% end %>
              <% else %>
                <%= button_to like_want_path(want), method: :post,
                      class: "rounded-full border border-[#111827]/20 bg-white px-4 py-2 text-sm font-bold text-[#111827] cursor-pointer
                              hover:bg-[#F9FAFB] hover:shadow-sm transition duration-150
                              focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" do %>
                  👍 <%= want.likes.size %>
                <% end %>
              <% end %>
              <%= link_to public_want_path(want),
                    class: "rounded-full border border-[#111827]/20 bg-white px-4 py-2 text-sm font-bold text-[#111827] cursor-pointer
                            hover:bg-[#F9FAFB] hover:shadow-sm transition duration-150
                            focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" do %>
                💬 <%= want.comments.size %>
              <% end %>
              <% if want.user == current_user %>
                <%= link_to "達成", achieve_form_want_path(want),
                      class: "rounded-full bg-[#1FA971] px-4 py-2 text-sm font-bold text-white cursor-pointer
                              hover:opacity-90 hover:shadow-md hover:-translate-y-0.5 transition duration-150
                              focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1FA971] focus-visible:ring-offset-1" %>
              <% end %>
            </div>

            <div class="mb-4"></div>
          <% end %>

          <div class="mt-4 flex justify-center">
            <%= paginate @wants %>
          </div>
        <% else %>
          <p class="text-sm font-bold text-[#6B7280]">公開されているやりたいことはまだありません。</p>
        <% end %>
      </div>
    </section>
  </div>
</div>
