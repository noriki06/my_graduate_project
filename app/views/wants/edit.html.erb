<div class="min-h-screen overflow-x-hidden bg-[#FBF6E9]">
  <div class="mx-auto max-w-[520px] px-4 py-10 sm:px-5">

    <!-- ヘッダー -->
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-extrabold text-[#111827]">やりたいことを編集</h1>
      <%= link_to "← 戻る", wants_path,
            class: "text-sm font-bold text-[#6B7280] cursor-pointer
                    hover:text-[#111827] transition duration-150
                    focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1 rounded" %>
    </div>

    <!-- バリデーションエラー -->
    <% if @want.errors.any? %>
      <div class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-5 py-4">
        <p class="text-sm font-extrabold text-red-700">入力内容を確認してください</p>
        <ul class="mt-2 list-disc pl-5 text-sm font-bold text-red-700">
          <% @want.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- フォームカード -->
    <div class="mt-5 rounded-2xl border border-[#111827]/20 bg-white p-5">
      <%= render "wants/form_modal" %>
    </div>

    <!-- 削除ボタン -->
    <div class="mt-6 text-center">
      <%= button_to "削除する", want_path(@want),
            method: :delete,
            data: { turbo_confirm: "削除しますか？" },
            class: "cursor-pointer rounded-full border border-red-200 bg-red-50 px-6 py-2
                    text-sm font-extrabold text-red-600
                    hover:bg-red-100 transition duration-150" %>
    </div>

  </div>
</div>
