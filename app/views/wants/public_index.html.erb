<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[720px] px-5 py-8">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-3xl font-extrabold text-[#111827]">みんなの達成</h1>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to public_wishlist_path, class: "inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-[#111827]/25 bg-white px-3 py-1.5 text-sm font-bold sm:px-5 sm:py-2 sm:text-base" do %>
          🌍 やりたいこと
        <% end %>
        <%= link_to wants_path, class: "inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-[#111827]/25 bg-white px-3 py-1.5 text-sm font-bold sm:px-5 sm:py-2 sm:text-base" do %>
          🏠 マイページ
        <% end %>
      </div>
    </div>

    <section class="rounded-2xl border border-[#111827]/20 bg-white p-5">
      <p class="text-base font-extrabold text-[#6B7280]">みんなの達成したやりたいこと</p>

      <div class="mt-4">
        <% if @wants.any? %>
          <% @wants.each do |want| %>
            <!-- 投稿者名 -->
            <p class="mb-1 text-xs font-bold text-[#6B7280]">
              👤 <%= want.user.name.presence || want.user.email %>
            </p>

            <%= render "wants/want_row", want: want, public_view: true %>

            <!-- アクション帯 -->
            <div class="mb-3 mt-2 flex items-center gap-3 px-2">
              <% liked = want.likes.any? { |l| l.user_id == current_user.id } %>
              <% if liked %>
                <%= button_to unlike_want_path(want), method: :delete,
                      class: "rounded-full border border-[#1FA971] bg-[#ECFDF5] px-4 py-2 text-sm font-bold text-[#065F46]" do %>
                  👍 <%= want.likes.size %>
                <% end %>
              <% else %>
                <%= button_to like_want_path(want), method: :post,
                      class: "rounded-full border border-[#111827]/20 bg-white px-4 py-2 text-sm font-bold text-[#111827]" do %>
                  👍 <%= want.likes.size %>
                <% end %>
              <% end %>
              <%= link_to public_want_path(want),
                    class: "rounded-full border border-[#111827]/20 bg-white px-4 py-2 text-sm font-bold text-[#111827]" do %>
                💬 <%= want.comments.size %>
              <% end %>
            </div>

            <%# 達成メモ（あれば） %>
            <% if want.achieved? && want.achievement_note.present? %>
              <div class="mt-2 mb-6 rounded-xl border border-[#1FA971]/20 bg-[#ECFDF5] px-4 py-3">
                <p class="text-xs font-bold text-[#065F46]">達成メモ</p>
                <div class="text-sm text-[#065F46]">
                  <%= simple_format(h(want.achievement_note)) %>
                </div>
              </div>
            <% else %>
              <div class="mb-4"></div>
            <% end %>
          <% end %>

          <div class="mt-4 flex justify-center">
            <%= paginate @wants %>
          </div>
        <% else %>
          <p class="text-sm font-bold text-[#6B7280]">公開されているやりたいことはまだありません。</p>
        <% end %>
      </div>
    </section>
  </div>
</div>
