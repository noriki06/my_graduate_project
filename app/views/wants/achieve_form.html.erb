<h1>達成の記録</h1>

<p><strong><%= @want.title %></strong></p>

<%= form_with model: @want, url: achieve_want_path(@want), method: :patch do |f| %>
  <p>
    <%= f.label :achieved_at, "達成日（任意）" %><br>
    <%= f.date_field :achieved_at %>
  </p>

  <p>
    <%= f.label :achievement_note, "達成時の気持ち・メモ" %><br>
    <%= f.text_area :achievement_note, rows: 6 %>
  </p>

  <%= f.submit "達成を保存する", data: { turbo_confirm: "達成として記録しますか？" } %>
<% end %>

<hr>
<%= link_to "戻る", want_path(@want) %>
