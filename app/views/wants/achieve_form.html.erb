<div class="min-h-screen overflow-x-hidden bg-[#FBF6E9]">
  <div class="mx-auto max-w-[420px] px-4 py-6">

    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-extrabold text-[#111827]">達成の記録</h1>
      <%= link_to "← 戻る", wants_path, class: "text-sm font-bold text-[#6B7280] cursor-pointer hover:text-[#111827] transition duration-150" %>
    </div>

    <section class="mt-5 rounded-2xl border border-[#111827]/20 bg-white p-5">
      <p class="text-lg font-extrabold text-[#111827]"><%= @want.title %></p>

      <% if @want.picture.attached? %>
        <div class="mt-3">
          <%= image_tag @want.picture.variant(resize_to_limit: [400, 400]),
                alt: @want.title,
                class: "w-full rounded-xl object-cover max-h-48" %>
        </div>
      <% end %>

      <%= form_with model: @want, url: achieve_want_path(@want), method: :patch do |f| %>

        <div class="mt-4 min-w-0 overflow-hidden">
          <%= f.label :achieved_at, "達成日（任意）", class: "text-sm font-bold text-[#6B7280]" %>
          <%= f.date_field :achieved_at,
                class: "mt-2 w-full min-w-0 max-w-full rounded-xl border border-[#111827]/20 bg-white px-3 py-2 text-sm" %>
          <p class="mt-1 text-xs font-bold text-[#9CA3AF]">未入力なら「今日」で記録されます</p>
        </div>

        <div class="mt-4">
          <%= f.label :achievement_note, "達成時の気持ち・メモ", class: "text-sm font-bold text-[#6B7280]" %>
          <%= f.text_area :achievement_note, rows: 6,
                class: "mt-2 w-full rounded-xl border border-[#111827]/20 bg-white px-3 py-2 text-base",
                placeholder: "達成した理由、嬉しかったこと、学びなど" %>
        </div>

        <!-- 達成写真 -->
        <div class="mt-4">
          <p class="text-sm font-bold text-[#6B7280]">
            達成の写真 <span class="ml-1 text-xs font-normal text-[#9CA3AF]">任意</span>
          </p>

          <% if @want.achieved_image.attached? %>
            <div class="mt-2">
              <%= image_tag @want.achieved_image.variant(resize_to_limit: [400, 400]),
                    alt: "達成写真",
                    class: "max-h-48 w-full rounded-xl object-cover" %>
            </div>
          <% end %>

          <%= f.file_field :achieved_image, accept: "image/*", class: "hidden", id: "want_achieved_image_field" %>

          <label for="want_achieved_image_field"
                 class="mt-2 inline-block cursor-pointer rounded-full border border-[#111827]/25 bg-white px-6 py-2.5
                        text-sm font-bold text-[#111827]
                        hover:bg-[#F3F4F6] transition duration-150">
            <%= @want.achieved_image.attached? ? "写真を変更する" : "写真を選択する" %>
          </label>
        </div>

        <div class="mt-5 flex gap-3">
          <%= f.submit "達成を保存する",
                data: { turbo_confirm: "達成として記録しますか？" },
                class: "flex-1 rounded-full bg-[#1FA971] px-4 py-3 text-sm font-extrabold text-white hover:opacity-90" %>

          <%= link_to "キャンセル", wants_path,
                class: "cursor-pointer rounded-full border border-[#111827]/20 bg-white px-4 py-3
                        text-sm font-extrabold text-[#111827] text-center
                        hover:bg-[#F3F4F6] transition duration-150" %>
        </div>

      <% end %>
    </section>

  </div>
</div>
