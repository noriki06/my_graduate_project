<% achieved = want.achieved? %>
<% button_class = "w-36 rounded-full px-4 py-2 text-sm font-extrabold text-center" %>
<% public_view = local_assigns.fetch(:public_view, false) %>
<% detail_path = public_view ? public_want_path(want) : want_path(want) %>

<div class="rounded-2xl border border-[#111827]/20 bg-white px-5 py-4">
  <div class="flex items-start justify-between gap-6">
    <!-- 左側：テキスト -->
    <div class="min-w-0 flex-1">
      <!-- タイトル -->
      <%= link_to detail_path, class: "text-lg font-extrabold text-[#111827] break-words hover:underline block" do %>
        <%= want.title %>
      <% end %>

      <div class="mt-2 flex flex-wrap items-center gap-2 text-sm font-bold">
        <% if achieved %>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#111827]/20 bg-[#ECFDF5] px-3 py-1 text-[#065F46]">
            🎉 達成
          </span>
          <span class="text-[#6B7280]">
            達成日：<%= (want.achieved_at || Time.current).to_date.strftime("%Y/%m/%d") %>
          </span>
        <% else %>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#111827]/20 bg-[#F3F4F6] px-3 py-1 text-[#111827]">
            ⏳ 未達成
          </span>
          <span class="text-[#6B7280]">
            達成目標日：
            <% if want.target_date.present? %>
              <%= want.target_date.strftime("%Y/%m/%d") %>
            <% else %>
              未定
            <% end %>
          </span>
        <% end %>
      </div>

      <!-- メモ：高さブレ防止 -->
      <p class="mt-2 text-sm text-[#6B7280] line-clamp-1 min-h-[20px]">
        <% if achieved && want.achievement_note.present? %>
          <%= want.achievement_note %>
        <% end %>
      </p>

      <%# 公開/非公開切り替え（自分のwant・一覧ページのみ） %>
      <% if !public_view && want.user == current_user %>
        <% if want.published? %>
          <%= button_to "非公開にする", toggle_publish_want_path(want), method: :patch,
            class: "inline-flex items-center rounded-full border border-[#1FA971]/20 bg-[#ECFDF5] px-3 py-1 text-xs font-extrabold text-[#065F46] mt-1" %>
        <% else %>
          <%= button_to "公開する", toggle_publish_want_path(want), method: :patch,
            class: "inline-flex items-center rounded-full border border-[#1FA971]/20 bg-[#F3F4F6] px-3 py-1 text-xs font-extrabold text-[#1FA971] mt-1" %>
        <% end %>
      <% end %>
    </div>

    <!-- 右側：画像 + ボタン（固定幅の塊） -->
    <div class="shrink-0 flex items-start gap-3">
      <!-- 画像枠：常に確保（No Imageは表示しない） -->
      <%= link_to detail_path, class: "block" do %>
        <div class="h-12 w-16 sm:h-14 sm:w-20 rounded-lg border border-[#111827]/10 bg-[#F9FAFB] flex items-center justify-center overflow-hidden">
          <% if achieved && want.achieved_image.attached? %>
            <%= image_tag want.achieved_image.variant(resize_to_limit: [160, 112]),
                  alt: want.title,
                  class: "max-h-12 max-w-[72px] object-contain" %>
          <% elsif want.picture.attached? %>
            <%= image_tag want.picture.variant(resize_to_limit: [160, 112]),
                  alt: want.title,
                  class: "max-h-12 max-w-[72px] object-contain" %>
          <% end %>
        </div>
      <% end %>

      <!-- ボタン（幅固定＋子をblockにして幅を効かせる） -->
      <% unless public_view %>
        <div class="flex flex-col items-stretch gap-2 w-24 sm:w-36">
          <% if achieved %>
            <%= link_to "思い出メモ",
                  achieve_form_want_path(want),
                  class: "block w-full rounded-full border border-[#111827]/20 bg-white px-4 py-2 text-sm font-extrabold text-[#111827] text-center" %>
          <% else %>
            <%= link_to "達成",
                  achieve_form_want_path(want),
                  class: "block w-full rounded-full bg-[#1FA971] px-4 py-2 text-sm font-extrabold text-white hover:opacity-90 text-center" %>

            <%= link_to "編集",
                  edit_want_path(want),
                  class: "block w-full rounded-full border border-[#111827]/20 bg-white px-4 py-2 text-sm font-extrabold text-[#111827] text-center" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
