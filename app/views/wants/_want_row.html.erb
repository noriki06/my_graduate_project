<% achieved = want.achieved? %>
<% public_view = local_assigns.fetch(:public_view, false) %>
<% detail_path = public_view ? public_want_path(want) : want_path(want) %>

<%# カード（内部に押せる要素あり → 軽くカード自体も浮かせる）%>
<div class="rounded-2xl border border-[#111827]/20 bg-white px-5 py-4 transition duration-150 hover:shadow-sm">
  <div class="flex items-start justify-between gap-3 sm:gap-6">

    <!-- 左側：テキスト -->
    <div class="min-w-0 flex-1">

      <%# タイトル（テキストリンク → hoverで色変化のみ）%>
      <%= link_to detail_path,
            class: "text-lg font-extrabold text-[#111827] break-words block cursor-pointer
                    hover:text-[#1FA971] transition duration-150
                    focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1 rounded" do %>
        <%= want.title %>
      <% end %>

      <%# ステータスバッジ（静的ピル・押せない）%>
      <div class="mt-2 flex flex-wrap items-center gap-2 text-sm font-bold">
        <% if achieved %>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#111827]/20 bg-[#ECFDF5] px-3 py-1 text-[#065F46]">
            🎉 達成
          </span>
          <span class="text-[#6B7280]">
            達成日：<%= (want.achieved_at || Time.current).to_date.strftime("%Y/%m/%d") %>
          </span>
        <% else %>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#111827]/20 bg-[#F3F4F6] px-3 py-1 text-[#111827]">
            ⏳ 未達成
          </span>
          <span class="text-[#6B7280]">
            達成目標日：
            <% if want.target_date.present? %>
              <%= want.target_date.strftime("%Y/%m/%d") %>
            <% else %>
              未定
            <% end %>
          </span>
        <% end %>
      </div>

      <%# メモ %>
      <% if public_view && achieved && want.achievement_note.present? %>
        <div class="mt-3 rounded-xl bg-green-50 px-4 py-3">
          <p class="text-xs font-bold text-[#6B7280]">達成メモ</p>
          <div class="mt-1 text-sm text-[#111827]">
            <%= simple_format(h(want.achievement_note)) %>
          </div>
        </div>
      <% elsif !public_view %>
        <p class="mt-2 text-sm text-[#6B7280] line-clamp-1 min-h-[20px]">
          <% if achieved && want.achievement_note.present? %>
            <%= want.achievement_note %>
          <% end %>
        </p>
      <% end %>

      <%# 公開/非公開トグルピル（現在状態を表示・hoverで次の状態をプレビュー）%>
      <% if !public_view && want.user == current_user %>
        <% if want.published? %>
          <%# 公開中 → hover で非公開プレビュー（赤系）%>
          <%= button_to toggle_publish_want_path(want), method: :patch,
                form_class: "inline mt-1",
                class: "inline-flex items-center rounded-full border border-[#1FA971]/30 bg-[#ECFDF5]
                        px-3 py-1 text-xs font-extrabold text-[#065F46] cursor-pointer
                        hover:bg-[#FEE2E2] hover:text-[#991B1B] hover:border-[#FCA5A5]/50
                        transition duration-150
                        focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1FA971] focus-visible:ring-offset-1" do %>
            🌍 公開中
          <% end %>
        <% else %>
          <%# 非公開 → hover で公開プレビュー（緑系）%>
          <%= button_to toggle_publish_want_path(want), method: :patch,
                form_class: "inline mt-1",
                class: "inline-flex items-center rounded-full border border-[#111827]/15 bg-[#F3F4F6]
                        px-3 py-1 text-xs font-extrabold text-[#6B7280] cursor-pointer
                        hover:bg-[#ECFDF5] hover:text-[#065F46] hover:border-[#1FA971]/30
                        transition duration-150
                        focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" do %>
            🔒 非公開
          <% end %>
        <% end %>
      <% end %>

    </div>

    <!-- 右側：画像 + ボタン -->
    <div class="shrink-0 flex items-start gap-3">

      <%# 画像（テキストリンクと同格 → hoverで薄く）%>
      <%= link_to detail_path,
            class: "block cursor-pointer hover:opacity-75 transition duration-150
                    focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1 rounded-lg" do %>
        <div class="h-10 w-14 sm:h-14 sm:w-20 rounded-lg border border-[#111827]/10 bg-[#F9FAFB] overflow-hidden">
          <% if achieved && want.achieved_image.attached? %>
            <%= image_tag want.achieved_image.variant(resize_to_fill: [160, 112]),
                  alt: want.title,
                  class: "w-full h-full object-cover" %>
          <% elsif want.picture.attached? %>
            <%= image_tag want.picture.variant(resize_to_fill: [160, 112]),
                  alt: want.title,
                  class: "w-full h-full object-cover" %>
          <% end %>
        </div>
      <% end %>

      <%# アクションボタン群 %>
      <% unless public_view %>
        <div class="flex flex-col items-stretch gap-2 w-[72px] sm:w-36">
          <% if achieved %>
            <%# 副ボタン（枠線）: 浮く＋薄影 %>
            <%= link_to "思い出メモ",
                  achieve_form_want_path(want),
                  class: "block w-full rounded-full border border-[#111827]/20 bg-white
                          px-1 py-2 sm:px-4 text-xs sm:text-sm font-extrabold text-[#111827] text-center cursor-pointer
                          hover:bg-[#F9FAFB] hover:shadow-sm hover:-translate-y-0.5 transition duration-150
                          focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" %>
          <% else %>
            <%# 主ボタン（濃色）: 浮く＋濃影 %>
            <%= link_to "達成",
                  achieve_form_want_path(want),
                  class: "block w-full rounded-full bg-[#1FA971]
                          px-1 py-2 sm:px-4 text-xs sm:text-sm font-extrabold text-white text-center cursor-pointer
                          hover:opacity-90 hover:shadow-md hover:-translate-y-0.5 transition duration-150
                          focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1FA971] focus-visible:ring-offset-1" %>
            <%# 副ボタン（枠線）%>
            <%= link_to "編集",
                  edit_want_path(want),
                  class: "block w-full rounded-full border border-[#111827]/20 bg-white
                          px-1 py-2 sm:px-4 text-xs sm:text-sm font-extrabold text-[#111827] text-center cursor-pointer
                          hover:bg-[#F9FAFB] hover:shadow-sm hover:-translate-y-0.5 transition duration-150
                          focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
