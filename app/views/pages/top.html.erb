<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[420px] px-4 py-10 text-center">

    <!-- ロゴ -->
    <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-[#FF6B6B] shadow-[6px_6px_0_#111827]">
      <span class="text-2xl" aria-hidden="true">🚀</span>
    </div>

    <h1 class="text-3xl font-extrabold tracking-wide text-[#FF6B6B]">
      ライフゲージ
    </h1>

    <!-- キャッチ -->
    <div class="mx-auto mt-4 w-fit rounded-2xl border-2 border-[#111827] bg-white px-5 py-3 shadow-[6px_6px_0_#111827]">
      <p class="text-sm font-extrabold text-[#111827]">
        ― 限りある人生を、今すぐ遊びつくそう！ ―
      </p>
    </div>

    <!-- 説明 -->
    <p class="mx-auto mt-6 max-w-[340px] text-sm leading-7 text-[#374151]">
      人生には限りがあります。<br>
      このアプリは、あなたの<strong>人生の現在地</strong>を見える化し、<br>
      やりたいことを叶えるための“魔法のツール”です。
    </p>

    <!-- CTA（ログイン状態で切り替え） -->
    <div class="mt-6 flex flex-col items-center gap-4">

      <% if user_signed_in? %>
        <!-- やりたいことリスト -->
        <%= link_to "やりたいことリストへ",
              wants_path,
              class: "w-full rounded-2xl border-2 border-[#111827] bg-[#46D2C4] px-5 py-4 text-sm font-extrabold text-[#111827]
                     shadow-[6px_6px_0_#111827] transition-all duration-150
                     hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[8px_8px_0_#111827] hover:brightness-110
                     active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0_#111827]" %>

        <!-- ログアウト -->
        <%= button_to "ログアウト",
              destroy_user_session_path,
              method: :delete,
              class: "w-full rounded-2xl border-2 border-[#111827] bg-[#FF6B6B] px-5 py-4 text-sm font-extrabold text-white
                     shadow-[6px_6px_0_#111827] transition-all duration-150
                     hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[8px_8px_0_#111827] hover:brightness-110
                     active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0_#111827]" %>

      <% else %>
        <!-- 新規登録（主CTA） -->
        <%= link_to "新規登録してスタート！",
              new_user_registration_path,
              class: "w-full rounded-2xl border-2 border-[#111827] bg-[#46D2C4] px-5 py-4 text-sm font-extrabold text-[#111827]
                     shadow-[6px_6px_0_#111827] transition-all duration-150
                     hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[8px_8px_0_#111827] hover:brightness-110
                     active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0_#111827]" %>

        <!-- ログイン（別色） -->
        <%= link_to "ログイン",
              new_user_session_path,
              class: "w-full rounded-2xl border-2 border-[#111827] bg-[#FFE57A] px-5 py-4 text-sm font-extrabold text-[#111827]
                     shadow-[6px_6px_0_#111827] transition-all duration-150
                     hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[8px_8px_0_#111827] hover:brightness-110
                     active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0_#111827]" %>
      <% end %>

    </div>

    <!-- 遊び方 -->
    <div class="mt-10 rounded-2xl border-2 border-dashed border-[#46D2C4] bg-white/60 px-5 py-6">
      <h2 class="text-xl font-extrabold text-[#111827]">
        Life Gauge の遊び方
      </h2>
      <div class="mx-auto mt-2 h-1 w-10 rounded-full bg-[#FFE57A]"></div>

      <div class="mt-6 flex flex-col gap-4 text-left">

        <div class="flex gap-3 rounded-2xl border-2 border-[#111827] bg-white px-4 py-4 shadow-[6px_6px_0_#111827]">
          <div class="grid h-11 w-11 place-items-center rounded-2xl bg-[#CFF7F2]">🗺️</div>
          <div>
            <h3 class="text-sm font-extrabold text-[#111827]">1. 人生の地図を見る</h3>
            <p class="mt-1 text-sm leading-6 text-[#374151]">
              生年月日から残り時間を可視化<br>
              人生の現在地を知ろう
            </p>
          </div>
        </div>

        <div class="flex gap-3 rounded-2xl border-2 border-[#111827] bg-white px-4 py-4 shadow-[6px_6px_0_#111827]">
          <div class="grid h-11 w-11 place-items-center rounded-2xl bg-[#FFE1E1]">⭐️</div>
          <div>
            <h3 class="text-sm font-extrabold text-[#111827]">2. 夢のリストを作る</h3>
            <p class="mt-1 text-sm leading-6 text-[#374151]">
              人生でやりたいことを、書き出そう<br>
              夢は、言葉にした瞬間から現実に近づく
            </p>
          </div>
        </div>

        <div class="flex gap-3 rounded-2xl border-2 border-[#111827] bg-white px-4 py-4 shadow-[6px_6px_0_#111827]">
          <div class="grid h-11 w-11 place-items-center rounded-2xl bg-[#DDEBFF]">⚡️</div>
          <div>
            <h3 class="text-sm font-extrabold text-[#111827]">3. 今、楽しむ！</h3>
            <p class="mt-1 text-sm leading-6 text-[#374151]">
              健康なうちに最高の体験を
            </p>
          </div>
        </div>

      </div>
    </div>

    <div class="mt-8 rounded-2xl border-2 border-[#111827] bg-white px-5 py-5 shadow-[6px_6px_0_#111827] text-left">
      <div class="flex items-start gap-3">
        <div class="grid h-11 w-11 place-items-center rounded-2xl bg-[#FFE57A]">📘</div>
        <div class="flex-1">
          <h3 class="text-sm font-extrabold text-[#111827]">Die With Zeroとは？</h3>
          <p class="mt-1 text-sm leading-6 text-[#374151]">
            ライフゲージの思想の元になった考え方と、アプリで実現できることをまとめました。
          </p>

          <div class="mt-4 flex flex-col gap-3">
            <%= link_to "思想ページを見る",
                  die_with_zero_path,
                  class: "w-full rounded-2xl border-2 border-[#111827] bg-[#FFE57A] px-5 py-3 text-sm font-extrabold text-[#111827]
                        shadow-[6px_6px_0_#111827] text-center transition-all duration-150
                        hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[8px_8px_0_#111827] hover:brightness-110
                        active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0_#111827]" %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center gap-2">
      <div class="flex gap-4 text-xs text-[#6B7280]">
        <%= link_to "利用規約", terms_path, class: "underline hover:text-[#111827]" %>
        <span>|</span>
        <%= link_to "プライバシーポリシー", privacy_path, class: "underline hover:text-[#111827]" %>
      </div>
      <p class="text-xs text-[#6B7280]">© Life Gauge</p>
    </div>

  </div>
</div>
