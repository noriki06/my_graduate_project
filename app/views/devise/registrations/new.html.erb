<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[420px] px-4 py-10 text-center">

    <!-- ロゴ -->
    <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-[#FF6B6B] shadow-[6px_6px_0_#111827]">
      <span class="text-2xl" aria-hidden="true">🚀</span>
    </div>

    <h1 class="text-3xl font-extrabold tracking-wide text-[#FF6B6B]">
      はじめる
    </h1>

    <div class="mx-auto mt-4 w-fit rounded-2xl border-2 border-[#111827] bg-white px-5 py-3 shadow-[6px_6px_0_#111827]">
      <p class="text-sm font-extrabold text-[#111827]">
        30秒で登録完了。思い出づくりを始めよう！
      </p>
    </div>

    <!-- エラー表示 -->
    <div class="mt-6 text-left">
      <%= render "devise/shared/error_messages", resource: resource %>
    </div>

    <!-- ソーシャルログイン -->
    <div class="mt-6 rounded-2xl border-2 border-[#111827] bg-white/70 px-6 py-6 shadow-[6px_6px_0_#111827]">
      <p class="mb-4 text-center text-sm font-bold text-[#6B7280]">
        SNS アカウントで始める（30秒）
      </p>

      <div class="grid grid-cols-2 gap-4">
        <!-- Google -->
        <%= button_to user_google_oauth2_omniauth_authorize_path,
              method: :post,
              data: { turbo: false },
              class: "group w-full rounded-2xl border-2 border-[#111827] bg-white px-4 py-5 shadow-[4px_4px_0_#111827]
                      transition-all duration-150
                      hover:-translate-x-[1px] hover:-translate-y-[1px] hover:shadow-[6px_6px_0_#111827] hover:bg-gray-50
                      active:translate-x-[1px] active:translate-y-[1px] active:shadow-[2px_2px_0_#111827]" do %>
          <div class="flex flex-col items-center justify-center">
            <svg class="h-16 w-16" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <span class="mt-3 text-sm font-extrabold text-[#111827]">Google</span>
          </div>
        <% end %>

        <!-- GitHub -->
        <%= button_to user_github_omniauth_authorize_path,
              method: :post,
              data: { turbo: false },
              class: "group w-full rounded-2xl border-2 border-[#111827] bg-white px-4 py-5 shadow-[4px_4px_0_#111827]
                      transition-all duration-150
                      hover:-translate-x-[1px] hover:-translate-y-[1px] hover:shadow-[6px_6px_0_#111827] hover:bg-gray-50
                      active:translate-x-[1px] active:translate-y-[1px] active:shadow-[2px_2px_0_#111827]" do %>
          <div class="flex flex-col items-center justify-center">
            <!-- 黒い丸 + 白いGitHub -->
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-black">
              <svg class="h-9 w-9 fill-white" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.83.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="mt-3 text-sm font-extrabold text-[#111827]">GitHub</span>
          </div>
        <% end %>
      </div>

      <p class="mt-5 text-center text-xs text-[#6B7280]">
        ── または メールアドレスで登録 ──
      </p>
    </div>

    <!-- フォーム -->
    <div class="mt-6 rounded-2xl border-2 border-[#111827] bg-white/70 px-5 py-6 text-left shadow-[6px_6px_0_#111827]">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |f| %>

        <!-- 名前 -->
        <div>
          <label class="text-sm font-extrabold text-[#111827]">
            名前
          </label>
          <div class="mt-2 rounded-2xl border-2 border-[#111827] bg-white px-4 py-3 shadow-[4px_4px_0_#111827]">
            <%= f.text_field :name,
                  autocomplete: "name",
                  placeholder: "例）大平 尭宜",
                  class: "w-full bg-transparent text-sm font-semibold text-[#111827] placeholder:text-[#9CA3AF] outline-none" %>
          </div>
        </div>

        <!-- メール -->
        <div class="mt-5">
          <label class="text-sm font-extrabold text-[#111827]">
            メールアドレス
          </label>
          <div class="mt-2 rounded-2xl border-2 border-[#111827] bg-white px-4 py-3 shadow-[4px_4px_0_#111827]">
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "example@mail.com",
                  class: "w-full bg-transparent text-sm font-semibold text-[#111827] placeholder:text-[#9CA3AF] outline-none" %>
          </div>
        </div>

        <!-- パスワード -->
        <div class="mt-5">
          <label class="text-sm font-extrabold text-[#111827]">
            パスワード
          </label>

          <% if @minimum_password_length %>
            <p class="mt-1 text-xs text-[#374151]">
              ※ <%= @minimum_password_length %>文字以上で入力してください
            </p>
          <% end %>

          <div class="mt-2 rounded-2xl border-2 border-[#111827] bg-white px-4 py-3 shadow-[4px_4px_0_#111827]">
            <%= f.password_field :password,
                  autocomplete: "new-password",
                  placeholder: "••••••••",
                  class: "w-full bg-transparent text-sm font-semibold text-[#111827] placeholder:text-[#9CA3AF] outline-none" %>
          </div>
        </div>

        <!-- パスワード確認 -->
        <div class="mt-5">
          <label class="text-sm font-extrabold text-[#111827]">
            パスワード（確認用）
          </label>
          <div class="mt-2 rounded-2xl border-2 border-[#111827] bg-white px-4 py-3 shadow-[4px_4px_0_#111827]">
            <%= f.password_field :password_confirmation,
                  autocomplete: "new-password",
                  placeholder: "••••••••",
                  class: "w-full bg-transparent text-sm font-semibold text-[#111827] placeholder:text-[#9CA3AF] outline-none" %>
          </div>
        </div>

        <!-- 送信 -->
        <div class="mt-6">
          <%= f.submit "登録する",
                class: "w-full rounded-2xl border-2 border-[#111827] bg-[#46D2C4] px-5 py-4 text-sm font-extrabold text-[#111827]
                        shadow-[6px_6px_0_#111827] transition-all duration-150
                        hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[8px_8px_0_#111827] hover:brightness-110
                        active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0_#111827]" %>
        </div>

      <% end %>
    </div>

    <!-- ログイン導線 -->
    <div class="mt-6 flex flex-col items-center gap-4">
      <p class="text-xs text-[#6B7280]">
        すでにアカウントをお持ちですか？
      </p>

      <%= link_to "ログインする",
            new_user_session_path,
            class: "rounded-2xl border-2 border-[#111827] bg-[#FFE57A] px-6 py-3 text-sm font-extrabold text-[#111827]
                    shadow-[6px_6px_0_#111827] transition-all duration-150
                    hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[8px_8px_0_#111827] hover:brightness-110
                    active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0_#111827]" %>
    </div>
