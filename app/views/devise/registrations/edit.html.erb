<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[720px] px-5 py-8">

    <!-- ヘッダー -->
    <div class="flex items-center justify-between">
      <h1 class="text-4xl font-extrabold text-[#111827]">プロフィール編集</h1>

      <%= link_to wants_path,
            class: "inline-flex items-center gap-2 rounded-full border border-[#111827]/25 bg-white px-5 py-2 text-base font-bold" do %>
        ← 戻る
      <% end %>
    </div>

    <!-- フォームカード -->
    <div class="mt-6 rounded-2xl border border-[#111827]/20 bg-white p-6">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

        <% if resource.errors.any? %>
          <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700">
            <p>入力内容を確認してください</p>
            <ul class="mt-2 list-disc pl-5 font-normal">
              <% resource.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-5">
          <!-- 名前 -->
          <div>
            <%= f.label :name, "名前",
                  class: "block text-sm font-extrabold text-[#6B7280]" %>
            <%= f.text_field :name,
                  class: "mt-2 w-full rounded-2xl border border-[#111827]/20 bg-white px-4 py-3 text-base font-bold text-[#111827] outline-none focus:border-[#111827]/40" %>
          </div>

          <!-- 生年月日 -->
          <div>
            <%= f.label :birthday, "生年月日",
                  class: "block text-sm font-extrabold text-[#6B7280]" %>
            <%= f.date_field :birthday,
                  class: "mt-2 w-full rounded-2xl border border-[#111827]/20 bg-white px-4 py-3 text-base font-bold text-[#111827] outline-none focus:border-[#111827]/40" %>
            <p class="mt-1 text-xs font-bold text-[#6B7280]">
              人生進捗率に使われます
            </p>
          </div>

          <!-- ボタン -->
          <div class="pt-2 flex items-center gap-3">
            <%= f.submit "更新する",
                  class: "inline-flex w-full items-center justify-center rounded-full bg-[#111827] px-5 py-3 text-base font-extrabold text-white hover:opacity-90" %>

            <%= link_to "キャンセル", wants_path,
                  class: "inline-flex w-full items-center justify-center rounded-full border border-[#111827]/20 bg-white px-5 py-3 text-base font-extrabold text-[#111827]" %>
          </div>
        </div>

      <% end %>
    </div>

  </div>
</div>
