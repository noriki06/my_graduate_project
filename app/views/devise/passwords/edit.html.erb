<div class="min-h-screen bg-[#FBF6E9]">
  <div class="mx-auto max-w-[420px] px-4 py-10">

    <div class="text-center">
      <h1 class="text-2xl font-extrabold text-[#111827] leading-tight">
        パスワードを変更する
      </h1>

      <% if @minimum_password_length %>
        <p class="mt-3 text-sm font-semibold text-[#111827]/80">
          <span class="font-extrabold"><%= @minimum_password_length %></span> 文字以上で入力してね
        </p>
      <% end %>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                 html: { method: :put, class: "mt-8" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="rounded-2xl border-2 border-[#111827] bg-white/70 px-5 py-6 shadow-[6px_6px_0_#111827]">
        <p class="text-xs font-extrabold tracking-widest text-[#111827]">RESET PASSWORD</p>

        <label class="mt-4 block text-sm font-extrabold text-[#111827]">
          新しいパスワード
        </label>
        <div class="mt-2 rounded-2xl border-2 border-[#111827] bg-white px-4 py-3 shadow-[4px_4px_0_#111827]">
          <%= f.password_field :password,
                autofocus: true,
                autocomplete: "new-password",
                class: "w-full bg-transparent text-lg font-extrabold tracking-tight text-[#111827] outline-none" %>
        </div>

        <label class="mt-6 block text-sm font-extrabold text-[#111827]">
          新しいパスワード（確認）
        </label>
        <div class="mt-2 rounded-2xl border-2 border-[#111827] bg-white px-4 py-3 shadow-[4px_4px_0_#111827]">
          <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                class: "w-full bg-transparent text-lg font-extrabold tracking-tight text-[#111827] outline-none" %>
        </div>

        <div class="mt-8">
          <%= f.submit "変更する",
                class: "w-full rounded-[32px] border-2 border-[#111827] bg-[#74C69D] px-5 py-5 text-xl font-extrabold text-white
                        shadow-[6px_6px_0_#111827] active:translate-x-[1px] active:translate-y-[1px]" %>
        </div>
      </div>
    <% end %>

    <div class="mt-10 text-center">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
