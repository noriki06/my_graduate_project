<!DOCTYPE html>
<html>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NYV8P55JQX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-NYV8P55JQX');
    </script>
    <title><%= content_for(:title) || "ライフゲージ | 人生の現在地を可視化するアプリ" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- SEO -->
    <meta name="description" content="あなたは人生を、何％生きましたか？人生の現在地を可視化するアプリ「ライフゲージ」。">

    <!-- OGP -->
    <meta property="og:title" content="ライフゲージ | 人生の現在地を可視化するアプリ">
    <meta property="og:description" content="あなたは人生を、何％生きましたか？">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= "#{request.base_url}/ogp.png" %>">
    <meta property="og:site_name" content="ライフゲージ">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="ライフゲージ | 人生の現在地を可視化するアプリ">
    <meta name="twitter:description" content="あなたは人生を、何％生きましたか？">
    <meta name="twitter:image" content="<%= "#{request.base_url}/ogp.png" %>">

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="ライフゲージ">
    <meta name="theme-color" content="#3d4850">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% flash.each do |type, message| %>
      <div class="flash <%= type %>"><%= message %></div>
    <% end %>

    <% if user_signed_in? %>
      <%# ===== ナビ定義 ===== %>
      <% nav_items = [
        {
          label:  "🏠 トップ",
          url:    pages_top_path,
          active: current_page?(pages_top_path) || current_page?(root_path)
        },
        {
          label:  "👤 マイページ",
          url:    wants_path,
          active: (controller_name == "wants" && action_name == "index")
        },
        {
          label:  "🌍 みんな",
          url:    public_wants_path,
          active: (current_page?(public_wants_path) || current_page?(public_wishlist_path))
        },
        {
          label:  "🔔 通知",
          url:    edit_notification_setting_path,
          active: current_page?(edit_notification_setting_path)
        },
        {
          label:  "⚙️ プロフィール",
          url:    edit_profile_path,
          active: current_page?(edit_profile_path)
        },
      ] %>

      <%# ===== ヘッダー ===== %>
      <header class="sticky top-0 z-50 bg-[#FBF6E9]/90 backdrop-blur border-b border-[#111827]/10">

        <%# ── メイン行: ロゴ / CTA + ハンバーガー ── %>
        <div class="mx-auto max-w-[720px] px-4 flex items-center justify-between h-14">

          <%# 左: ロゴ %>
          <%= link_to "ライフゲージ", pages_top_path,
                class: "text-lg font-extrabold text-[#111827] cursor-pointer rounded
                        focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-2" %>

          <%# 右: CTAボタン + ハンバーガー %>
          <div class="flex items-center gap-2">
            <%= link_to new_want_path,
                  class: "inline-flex items-center whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-bold text-white cursor-pointer
                          bg-[#111827] border border-transparent shadow-sm hover:opacity-90 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0.5 transition duration-150
                          focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" do %>
              やりたいことを追加
            <% end %>

            <%# ハンバーガー（details/summary でJS不要） %>
            <details class="relative">
              <summary class="list-none inline-flex items-center justify-center w-9 h-9 rounded-full border border-[#111827]/25 bg-white shadow-sm
                             hover:bg-[#F3F4F6] hover:shadow-md transition duration-150 cursor-pointer
                             focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1"
                       aria-label="メニュー">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
              </summary>

              <nav class="absolute right-0 top-full mt-1 w-52 bg-[#FBF6E9] border border-[#111827]/10 rounded-xl shadow-lg py-2 z-50"
                   aria-label="メニュー">
                <% nav_items.each do |item| %>
                  <%= link_to item[:label], item[:url],
                        class: "flex items-center px-4 py-2 text-sm font-bold transition duration-150
                                #{item[:active] ? 'bg-[#111827] text-white' : 'text-[#111827] hover:bg-[#111827]/10'}" %>
                <% end %>

                <% if current_user.admin? %>
                  <%= link_to "🛡️ 管理", admin_root_path,
                        class: "flex items-center px-4 py-2 text-sm font-bold text-white bg-[#111827] hover:opacity-90 transition duration-150" %>
                <% end %>

                <div class="mt-1 pt-1 border-t border-[#111827]/10">
                  <%= button_to "🚪 ログアウト",
                        destroy_user_session_path,
                        method: :delete,
                        form_class: "w-full",
                        class: "w-full flex items-center px-4 py-2 text-sm font-bold text-red-500
                                hover:bg-red-50 transition duration-150 cursor-pointer" %>
                </div>
              </nav>
            </details>
          </div>
        </div>

        <%# ── サブナビ行（ページ別・content_for :subnav で注入）── %>
        <% if content_for?(:subnav) %>
          <div class="border-t border-[#111827]/10">
            <div class="mx-auto max-w-[720px] px-4 py-2">
              <%= yield :subnav %>
            </div>
          </div>
        <% end %>

      </header>
    <% end %>

    <%= yield %>
  </body>
</html>
