<!DOCTYPE html>
<html>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NYV8P55JQX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-NYV8P55JQX');
    </script>
    <title><%= content_for(:title) || "ライフゲージ | 人生の現在地を可視化するアプリ" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- SEO -->
    <meta name="description" content="あなたは人生を、何％生きましたか？人生の現在地を可視化するアプリ「ライフゲージ」。">

    <!-- OGP -->
    <meta property="og:title" content="ライフゲージ | 人生の現在地を可視化するアプリ">
    <meta property="og:description" content="あなたは人生を、何％生きましたか？">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= "#{request.base_url}/ogp.png" %>">
    <meta property="og:site_name" content="ライフゲージ">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="ライフゲージ | 人生の現在地を可視化するアプリ">
    <meta name="twitter:description" content="あなたは人生を、何％生きましたか？">
    <meta name="twitter:image" content="<%= "#{request.base_url}/ogp.png" %>">

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="ライフゲージ">
    <meta name="theme-color" content="#3d4850">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% flash.each do |type, message| %>
      <div class="flash <%= type %>"><%= message %></div>
    <% end %>

    <% if user_signed_in? %>
      <%# ===== 主ナビ定義（3項目 + active ラムダ） ===== %>
      <% nav_items = [
        {
          label:  "🏠 トップ",
          url:    pages_top_path,
          active: current_page?(pages_top_path) || current_page?(root_path)
        },
        {
          label:  "👤 マイページ",
          url:    wants_path,
          active: (controller_name == "wants" && action_name == "index")
        },
        {
          label:  "🌍 みんな",
          url:    public_wants_path,
          active: (current_page?(public_wants_path) || current_page?(public_wishlist_path))
        },
        {
          label:  "🔔 通知",
          url:    edit_notification_setting_path,
          active: current_page?(edit_notification_setting_path)
        },
        {
          label:  "⚙️ プロフィール",
          url:    edit_profile_path,
          active: current_page?(edit_profile_path)
        },
      ] %>

      <%# ===== ヘッダー: 主ナビ行 ＋ コンテキスト別サブナビ行 ===== %>
      <header class="sticky top-0 z-50 bg-[#FBF6E9]/90 backdrop-blur border-b border-[#111827]/10">

        <%# ── 主ナビ行 ── %>
        <%# モバイル: 行1=ロゴ+CTAボタン / 行2=ナビチップ、sm以上: 1行まとめ %>
        <div class="mx-auto max-w-[720px] px-4 flex flex-wrap items-center justify-center gap-x-3">

          <%# 左: ロゴ %>
          <%= link_to pages_top_path,
                class: "shrink-0 py-3 text-lg font-extrabold text-[#111827] cursor-pointer rounded
                        focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-2" do %>
            ライフゲージ
          <% end %>

          <%# 中: チップナビ（モバイルでは2行目・全幅、sm以上で1行目・flex-1）%>
          <nav class="order-last w-full pt-2 pb-3 sm:order-none sm:w-auto sm:flex-1 sm:min-w-0 sm:py-3" aria-label="グローバルナビゲーション">
            <div class="flex flex-wrap justify-center sm:justify-start items-center gap-2">
              <% nav_items.each do |item| %>
                <% if item[:active] %>
                  <span class="inline-flex items-center whitespace-nowrap rounded-full border px-3 py-1.5 text-sm font-bold
                               bg-[#111827] text-white border-transparent">
                    <%= item[:label] %>
                  </span>
                <% else %>
                  <%= link_to item[:label], item[:url],
                        class: "inline-flex items-center whitespace-nowrap rounded-full border px-3 py-1.5 text-sm font-bold transition duration-150 cursor-pointer
                                bg-white border-[#111827]/25 shadow-sm hover:bg-[#F3F4F6] hover:shadow-md hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none
                                focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" %>
                <% end %>
              <% end %>

              <%# ── 管理者リンク ── %>
              <% if current_user.admin? %>
                <%= link_to "🛡️ 管理", admin_root_path,
                      class: "inline-flex items-center whitespace-nowrap rounded-full border px-3 py-1.5 text-sm font-bold transition duration-150 cursor-pointer
                              bg-[#111827] border-transparent text-white shadow-sm hover:opacity-90 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none
                              focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" %>
              <% end %>

              <%# ── ログアウト（視覚的に区別できる赤系スタイル）── %>
              <%= button_to "🚪 ログアウト",
                    destroy_user_session_path,
                    method: :delete,
                    form_class: "inline-flex",
                    class: "inline-flex items-center whitespace-nowrap rounded-full border px-3 py-1.5 text-sm font-bold transition duration-150 cursor-pointer
                            bg-white border-red-300 text-red-500 shadow-sm hover:bg-red-50 hover:border-red-400 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none
                            focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-1" %>
            </div>
          </nav>

          <%# 右: CTA（モバイルでロゴの右端に配置）%>
          <%= link_to new_want_path,
                class: "shrink-0 mt-2 inline-flex items-center whitespace-nowrap rounded-full border px-3 py-1.5 text-sm font-bold text-white cursor-pointer
                        bg-[#111827] border-transparent shadow-sm hover:opacity-90 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition duration-150
                        focus:outline-none focus-visible:ring-2 focus-visible:ring-[#111827] focus-visible:ring-offset-1" do %>
            やりたいことを追加
          <% end %>

        </div>

        <%# ── サブナビ行（ページ別・content_for :subnav で注入）── %>
        <% if content_for?(:subnav) %>
          <div class="border-t border-[#111827]/10">
            <div class="mx-auto max-w-[720px] px-4 py-2">
              <%= yield :subnav %>
            </div>
          </div>
        <% end %>

      </header>
    <% end %>

    <%= yield %>
  </body>
</html>
