<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>管理画面 | ライフゲージ</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-100 min-h-screen">

    <!-- ヘッダー -->
    <header class="bg-[#111827] text-white px-6 py-4 flex items-center justify-between shadow">
      <div class="flex items-center gap-4">
        <span class="text-lg font-extrabold tracking-wide">🛡️ 管理画面</span>
        <nav class="flex gap-3 ml-4">
          <%= link_to "ユーザー管理", admin_users_path,
                class: "text-sm font-bold px-3 py-1.5 rounded-lg hover:bg-white/10 transition #{'bg-white/10' if controller_name == 'users'}" %>
          <%= link_to "投稿管理", admin_wants_path,
                class: "text-sm font-bold px-3 py-1.5 rounded-lg hover:bg-white/10 transition #{'bg-white/10' if controller_name == 'wants'}" %>
        </nav>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "← アプリへ戻る", root_path,
              class: "text-sm text-gray-300 hover:text-white transition" %>
      </div>
    </header>

    <!-- フラッシュ -->
    <% if notice %>
      <div class="bg-green-100 border border-green-300 text-green-800 px-6 py-3 text-sm font-bold">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-100 border border-red-300 text-red-800 px-6 py-3 text-sm font-bold">
        <%= alert %>
      </div>
    <% end %>

    <main class="px-6 py-8">
      <%= yield %>
    </main>

  </body>
</html>
